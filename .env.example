# Public browser configuration required by local and Cloudflare builds.
# Copy these values from the connected Lovable Cloud project's public settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional image-upload configuration used by the admin panel.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server runtime configuration for TanStack server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Never commit SUPABASE_SERVICE_ROLE_KEY or TELEGRAM_BOT_TOKEN. Add them as encrypted Cloudflare secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=